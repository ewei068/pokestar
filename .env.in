# client
STAGE=ALPHA
DISCORD_TOKEN=
CLIENT_ID=

# db
MONGODB_URL=mongodb://localhost:27017
DURABLE_BATTLES_ENABLED=false
DURABLE_RAIDS_ENABLED=false

# static web battler (configure OAuth redirect in the Discord developer portal)
# Optional Express bind address; local Vite proxy setups can use 127.0.0.1.
# Leave unset to retain the existing server bind behavior in production.
HTTP_HOST=
# Enable only behind one verified loopback reverse proxy with HTTP_HOST=127.0.0.1
# (or ::1). Replace incoming forwarding headers there and block public port 3000.
HTTP_TRUST_LOOPBACK_PROXY=false
WEB_BATTLER_ENABLED=false
WEB_SITE_ORIGIN=http://localhost:5173
# Match the static build's base path (for example /repository-name/).
WEB_BASE_PATH=/
WEB_DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_SECRET=

# voting sites (same for all stages, not required for dev i think)
BOTLIST_SECRET=
BOTLIST_TOKEN=
DBL_SECRET=
DISCORDLIST_TOKEN=
DBL_TOKEN=
TOPGG_TOKEN=
TOPGG_SECRET=

# flags
FFLAG_ENABLE_SPAWN=0
FFLAG_POLL_STATE_SIZE=1
