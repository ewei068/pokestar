# Copy to .env.local for local HTTPS. Paths are relative to web/.
# Set WEB_DEV_HOST to your Mac's Wi-Fi IP; keep localhost for Mac-only HTTP.
WEB_DEV_HOST=localhost
WEB_DEV_API_TARGET=http://127.0.0.1:3000
WEB_DEV_TLS_CERT=
WEB_DEV_TLS_KEY=
# Keep VITE_API_ORIGIN unset: /api requests go through the Vite proxy.
